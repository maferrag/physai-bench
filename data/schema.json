{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physai-bench.org/schema/instance-v1.json",
  "title": "PhysAI-Bench instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "instruction", "context", "candidates", "answer", "rationale", "metadata"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "instruction": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission", "physical_state", "observations", "tool_history", "a2a_interactions", "network_conditions"],
      "properties": {
        "mission": {"type": "string"},
        "physical_state": {"type": "object"},
        "observations": {"type": "array", "items": {"type": "string"}},
        "tool_history": {"type": "array", "items": {"type": "string"}},
        "a2a_interactions": {"type": "array", "items": {"type": "string"}},
        "network_conditions": {"type": "object"}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "action", "description"],
        "properties": {
          "label": {"enum": ["A", "B", "C", "D"]},
          "action": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "answer": {"enum": ["A", "B", "C", "D"]},
    "rationale": {"type": "string", "minLength": 1},
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_episode", "source_turn", "target_turn", "action_category", "difficulty", "physical_factors", "network_factors", "generator", "schema_version"],
      "properties": {
        "source_episode": {"type": "string", "minLength": 1},
        "source_turn": {"type": "integer", "minimum": 0},
        "target_turn": {"type": "integer", "minimum": 1},
        "action_category": {"type": "string", "minLength": 1},
        "difficulty": {"type": "string", "minLength": 1},
        "physical_factors": {"type": "array", "items": {"type": "string"}},
        "network_factors": {"type": "array", "items": {"type": "string"}},
        "generator": {"type": "string", "minLength": 1},
        "schema_version": {"const": "1.0"}
      }
    }
  }
}

